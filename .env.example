# Copy privately to .env. Never commit .env, tokens or the ownership journal.
# Process environment overrides this selected dotenv file. No ${...} interpolation.
# These are client-credentials APPLICATION identities, NOT the delegated evaluator.
# Use tenant GUIDs, not common/organizations; separate credential objects per role.

# Stable deployment marker/name prefix; changing it requires a separate journal.
DEMO_ID=elite_demo
# Repository-relative data-generator output; manifest/schema hashes are verified.
DATA_DIR=data
# Private local atomic journal; preserve across runs and back up before teardown.
FABRIC_STATE_PATH=.state/fabric-state.json
# Bounded API operation/job timeout (1..86400 seconds). Timeout does NOT cancel a job.
OPERATION_TIMEOUT_SECONDS=1800
# Parent adapter input; load_contract must expand YAML into a JSON-compatible dict.
ONTOLOGY_PATH=fabric/ontology/ontology.yaml
# Parent-owned nbformat4 notebooks; first code cell tagged parameters, CONFIG_JSON string.
NOTEBOOK01_PATH=fabric/notebooks/01_bronze_to_silver.ipynb
NOTEBOOK02_PATH=fabric/notebooks/02_silver_to_gold.ipynb
# Parent-owned agent instruction text; no secrets or embedded credentials.
AGENT_INSTRUCTIONS_PATH=agent/agent_instructions.md

# Provider tenant GUID: owns synthetic bronze/silver and firm-isolated gold only.
PROVIDER_TENANT_ID=
# Provider app registration ID; approved for Fabric APIs/workspace creation.
PROVIDER_CLIENT_ID=
# Provider application secret (prefer process environment/CI secret injection).
PROVIDER_CLIENT_SECRET=
# Active accessible Fabric capacity GUID; this tool never provisions capacity.
PROVIDER_CAPACITY_ID=
# Optional explicit adoption of an existing workspace; never deleted or retagged.
PROVIDER_WORKSPACE_ID=
# REQUIRED live: admin review reference/date for effective core permissions/settings.
# An attestation is always reported ATTESTED, never PASS or probed. No secrets here.
PROVIDER_ADMIN_ATTESTATION=
# Optional comma-separated EXACT settingName values from GET /v1/admin/tenantsettings.
# Disabled settings FAIL; missing/group-scoped values UNKNOWN. No guessed identifiers.
PROVIDER_CORE_SETTING_NAMES=

# Harbor consumer tenant GUID (external to provider except explicit simulation).
HARBOR_TENANT_ID=
# Harbor deployment app registration ID, scoped to its own consumer workspace.
HARBOR_CLIENT_ID=
# Harbor deployment app secret; never use provider credentials as an automatic fallback.
HARBOR_CLIENT_SECRET=
# Harbor active Fabric capacity GUID.
HARBOR_CAPACITY_ID=
# Optional adopted Harbor workspace. Simulation: same ID as KESTREL_WORKSPACE_ID.
HARBOR_WORKSPACE_ID=
# REQUIRED live admin core-permission review reference/date, not an API probe.
HARBOR_ADMIN_ATTESTATION=
# Optional exact core settingName list, independently reviewed in Harbor tenant.
HARBOR_CORE_SETTING_NAMES=

# Kestrel consumer tenant GUID; three independent tenants by default.
KESTREL_TENANT_ID=
# Kestrel deployment app registration ID; separate token client even in simulation.
KESTREL_CLIENT_ID=
# Kestrel application secret, injected privately.
KESTREL_CLIENT_SECRET=
# Kestrel active capacity GUID. Simulation: same as HARBOR_CAPACITY_ID.
KESTREL_CAPACITY_ID=
# Optional adopted Kestrel workspace. Normal/shared-consumer modes: distinct from Harbor.
KESTREL_WORKSPACE_ID=
# REQUIRED live admin core-permission review reference/date, not an API probe.
KESTREL_ADMIN_ATTESTATION=
# Optional exact core settingName list, independently reviewed in Kestrel tenant.
KESTREL_CORE_SETTING_NAMES=

# Parent evaluator integration ONLY. Not read by deployment and never logged here.
# Harbor delegated partner's immutable Entra USER object ID (not timekeeper/app ID).
HARBOR_PARTNER_OBJECT_ID=
# Harbor public-client app ID with device-code flow enabled; NO client secret.
HARBOR_USER_CLIENT_ID=
# Optional explicit evaluator tenant; normally equal to HARBOR_TENANT_ID.
HARBOR_USER_TENANT_ID=
# Parent uses the LIVE created agent UUID; no fake IDs from a dry-run.
HARBOR_AGENT_ID=
# Compatibility alias; when both are set they must match (unless --agent-id selects).
HARBOR_DATA_AGENT_ID=
# Kestrel delegated test user's immutable USER object ID.
KESTREL_PARTNER_OBJECT_ID=
# Kestrel public-client app ID for delegated device login; not KESTREL_CLIENT_ID.
KESTREL_USER_CLIENT_ID=
# Optional explicit delegated test tenant; normally KESTREL_TENANT_ID.
KESTREL_USER_TENANT_ID=
# Parent evaluator's live Kestrel agent UUID (only after supported binding).
KESTREL_DATA_AGENT_ID=
# No SHARE_ACCEPTED=true or SECURITY_VALIDATED=true bypass exists: these cannot prove
# source binding or RLS. External source verification and raw-graph security remain blocked.