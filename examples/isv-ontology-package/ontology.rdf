    <rdfs:range rdf:resource="https://isv.example/ontologies/elite-legal/PracticeGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://isv.example/ontologies/elite-legal/MatterMeasuredAgainstBudget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
