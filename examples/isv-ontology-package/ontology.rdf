<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://isv.example/ontologies/elite-legal/InvoiceBillsMatter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">An issued invoice bills one matter.</rdfs:label>
    <rdfs:domain rdf:resource="https://isv.example/ontologies/elite-legal/Invoice"/>
    <rdfs:range rdf:resource="https://isv.example/ontologies/elite-legal/Matter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://isv.example/ontologies/elite-legal/TimekeeperMatterAccess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">A timekeeper has an informational matter access adjacency.</rdfs:label>
    <rdfs:comment xml:lang="en">Informational only; this relationship is not an authorization grant.</rdfs:comment>
    <rdfs:domain rdf:resource="https://isv.example/ontologies/elite-legal/Timekeeper"/>
    <rdfs:range rdf:resource="https://isv.example/ontologies/elite-legal/Matter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://isv.example/ontologies/elite-legal/AdjustmentReducesProforma">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">An adjustment reduces a proforma.</rdfs:label>
    <rdfs:domain rdf:resource="https://isv.example/ontologies/elite-legal/Adjustment"/>
    <rdfs:range rdf:resource="https://isv.example/ontologies/elite-legal/Proforma"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://isv.example/ontologies/elite-legal/ProformaReviewedByTimekeeper">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">A proforma is assigned to a reviewer.</rdfs:label>
    <rdfs:domain rdf:resource="https://isv.example/ontologies/elite-legal/Proforma"/>
    <rdfs:range rdf:resource="https://isv.example/ontologies/elite-legal/Timekeeper"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://isv.example/ontologies/elite-legal/InvoiceSettledByPayment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">An invoice is settled by one or more payments.</rdfs:label>
    <rdfs:domain rdf:resource="https://isv.example/ontologies/elite-legal/Invoice"/>
    <rdfs:range rdf:resource="https://isv.example/ontologies/elite-legal/Payment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://isv.example/ontologies/elite-legal/AdjustmentApprovedByTimekeeper">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">An adjustment records its approving timekeeper.</rdfs:label>
    <rdfs:domain rdf:resource="https://isv.example/ontologies/elite-legal/Adjustment"/>
    <rdfs:range rdf:resource="https://isv.example/ontologies/elite-legal/Timekeeper"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://isv.example/ontologies/elite-legal/MatterWorkedByPracticeGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
